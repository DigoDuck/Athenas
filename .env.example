# Use mode settings. `make use-init` creates .env.use from this shape with
# generated secrets. Never commit .env.use.
POSTGRES_DB=athenas
POSTGRES_USER=athenas
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Backup (D-019): the staging folder on C: is bind-mounted into the backend, and the hourly
# task (scripts/backup.py) copies it to the vault folder. Both are absolute Windows paths.
BACKUP_STAGING=C:\Users\you\AthenasBackup
BACKUP_VAULT=G:\path\to\vault\Athenas backup
